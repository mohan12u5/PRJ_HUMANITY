DATABASE_URL="postgresql://postgres:password@db-host:5432/humanity?schema=public"
AUTH_JWT_SECRET="replace-with-a-strong-random-secret"

# Optional: Redis-backed rate limiting (falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: transactional email (falls back to console logging when unset)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="Humanity <no-reply@humanity.example>"

# Used to build absolute links in emails (e.g. password reset)
APP_BASE_URL="https://your-deployment-domain.example"
